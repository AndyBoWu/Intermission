{
  "name": "intermission",
  "version": "0.1.0",
  "private": true,
  "description": "Verification commands for the Intermission Omarchy plugin.",
  "scripts": {
    "test": "node tests/unit/run.js",
    "test:static": "bash tests/static-checks.sh",
    "test:shell": "bash tests/shell/scaffold-test.sh",
    "test:live": "bash tests/shell/live-lifecycle-test.sh",
    "lint:qml": "bash tests/qml-lint.sh",
    "lint:workflows": "bash tests/workflow-security.sh",
    "governance:verify": "bash scripts/github-governance.sh verify",
    "release:dry-run": "bash scripts/release-assets.sh build",
    "test:release": "bash tests/shell/release-assets-test.sh",
    "test:compatibility": "bash tests/compatibility-checks.sh",
    "audit:release": "bash tests/release-audit.sh",
    "check:portable": "npm test && npm run test:static && npm run audit:release && npm run test:release",
    "check": "npm run check:portable && npm run lint:qml"
  }
}
